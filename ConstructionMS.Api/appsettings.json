{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "ConstructionMS": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ItVerification": {
    "Enabled": false,
    "TesterUsername": ""
  },
  "EvidenceStorage": {
    "RootPath": "App_Data/evidence",
    "MaxFileBytes": 10485760
  },
  "TaskInbox": {
    "DefaultDueHours": 48,
    "UrgentDueHours": 24,
    "HandoverDueHours": 12,
    "NotificationSweepMinutes": 5,
    "InitialNotificationDelaySeconds": 30
  },
  "AllowedHosts": "localhost"
}
