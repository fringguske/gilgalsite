# Copy to .env.local for local development. On Vercel, add the same names under
# Project -> Settings -> Environment Variables (Production + Preview).

# ---- Required --------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler"
# (port 6543), e.g.
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Use the postgres (owner) user: every table has Row Level Security enabled with no
# policies, so only the owner connection can read and write business records.
DATABASE_URL=

# 32+ random characters used to sign the session cookie. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=

# Supabase -> Project Settings -> API: the Project URL and the service_role secret key.
# Used only on the server, for the private "evidence" Storage bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/overdue-notifications.
CRON_SECRET=

# ---- Optional --------------------------------------------------------------
# The browser calls the API on the same origin (/api/v1) by default; only set this
# if the API is hosted somewhere else.
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# Extra browser origins allowed to call the API cross-origin (normally not needed).
# CORS_ALLOWED_ORIGINS=

# DATABASE_POOL_MAX=5
# EVIDENCE_STORAGE_BUCKET=evidence
# EVIDENCE_STORAGE_MAX_FILE_BYTES=4194304

# IT verification (lets one named Administrator preview other roles); off by default.
# IT_VERIFICATION_ENABLED=false
# IT_VERIFICATION_TESTER_USERNAME=
# IT_VERIFICATION_TESTER_USER_ID=

# Verification codes by email over SMTP. With SMTP_HOST, SMTP_USER and SMTP_PASSWORD set,
# changing a password needs a 6-digit code emailed to the account's address, people confirm
# their address from the account menu, and a confirmed address can reset a forgotten password.
# Leave all of these unset to turn this off (password changes then work as before).
#   Gmail:  SMTP_HOST=smtp.gmail.com, SMTP_USER=the Gmail address, SMTP_PASSWORD=an app password
#           (Google Account -> Security -> turn on 2-Step Verification -> App passwords), not the
#           account password. Mail is sent from that Gmail address.
#   Resend: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASSWORD=the API key, and
#           EMAIL_FROM on a domain verified in Resend.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# 465 (the default) or 587:
# SMTP_PORT=465
# Defaults to "Construction Management System <SMTP_USER>":
# EMAIL_FROM=

# Task inbox timing (hours)
# TASK_INBOX_DEFAULT_DUE_HOURS=48
# TASK_INBOX_URGENT_DUE_HOURS=24
# TASK_INBOX_HANDOVER_DUE_HOURS=12

# One-time creation of the first Administrator (npm run bootstrap-administrator).
# Remove these values again afterwards.
# BOOTSTRAP_ADMINISTRATOR_USERNAME=
# BOOTSTRAP_ADMINISTRATOR_FULL_NAME=
# BOOTSTRAP_ADMINISTRATOR_EMAIL=
# BOOTSTRAP_ADMINISTRATOR_PHONE_NUMBER=
# BOOTSTRAP_ADMINISTRATOR_PASSWORD=
